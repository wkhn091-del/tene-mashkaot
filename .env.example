# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.
# Full instructions: DEPLOYMENT.md

# ── Site ────────────────────────────────────────────────────────────
# Production domain without a trailing slash (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Sanity ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-09-01
# Viewer token (server only) – required because the dataset is private
SANITY_API_READ_TOKEN=
# Editor token (server only) – saves orders and event inquiries, and is used by `npm run seed`
SANITY_API_WRITE_TOKEN=
# Random string shared with the Sanity webhook (openssl rand -hex 32)
SANITY_REVALIDATE_SECRET=

# ── Order e-mails (Resend) ─────────────────────────────────────────
RESEND_API_KEY=
# Where new orders / inquiries are sent (comma separated for several)
ORDERS_TO_EMAIL=
# Optional. Without a verified domain leave empty: mail goes from onboarding@resend.dev, and only to the
# e-mail address that owns the Resend account – so ORDERS_TO_EMAIL must be that address until a domain exists.
ORDERS_FROM_EMAIL=

# ── Bot protection (Cloudflare Turnstile) ──────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Rate limiting (Upstash Redis) ──────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# ── Payments & receipts (Morning / Green Invoice – API requires the "Best" plan) ──
# Morning → My account → Developer tools → API keys. Use sandbox keys in the Preview environment.
MORNING_API_KEY_ID=
MORNING_API_KEY_SECRET=
# production | sandbox
MORNING_ENV=production
# 320 = חשבונית מס/קבלה (עוסק מורשה) · 400 = קבלה (עוסק פטור)
MORNING_DOCUMENT_TYPE=320
# 1 = site prices include VAT (default) · 0 = before VAT · 2 = VAT exempt
MORNING_VAT_TYPE=1
# Optional: the clearing plugin id, only if the Morning account has more than one
MORNING_PAYMENT_PLUGIN_ID=
# Random string (openssl rand -hex 32): authenticates Morning's payment notifications
MORNING_WEBHOOK_SECRET=
# Random string shared with the Sanity "order paid → receipt" webhook
SANITY_ORDER_WEBHOOK_SECRET=
# ── WhatsApp Cloud API alerts to the store (integrations/whatsapp/TEMPLATES.md) ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Numbers that receive alerts, comma separated (e.g. 0535467863)
WHATSAPP_ALERT_TO=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_LANG=he
# ── Google Sheets sync (integrations/google-sheets) ──
# Random string (openssl rand -hex 32), entered once in the sheet's setup menu
SHEETS_EXPORT_TOKEN=
# ── Analytics (loaded only after the visitor opts in through the cookie banner) ──
# GA4: Admin → Data streams → Web → Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta Pixel: Events Manager → Data sources → Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
# Google Search Console → HTML tag verification → the content="…" value only
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# ── Error monitoring (Sentry, free Developer plan) ──
NEXT_PUBLIC_SENTRY_DSN=
# Build-time source map upload (Settings → Auth Tokens, scope project:releases)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
